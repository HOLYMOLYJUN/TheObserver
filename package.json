{
  "name": "the-observer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "관심 기업의 개발 채용공고를 사람인·잡코리아에서 감시해 Slack으로 알려주는 봇",
  "engines": { "node": ">=20" },
